// CPU rounding and denormal state ownership, independent of every SIMD profile.

// Admission data and decisions belong to this baseline module. Only the
// supplied startup evaluator is compiled with a numerical profile's options.
export namespace ftz {
  enum class ftz32_cpu_failure {
    none, environment_unavailable, normal_arithmetic, core_contract, hardware_ftz
  };

  // A startup observation for this compiled profile and the calling thread.
  // It neither changes controls nor configures another thread or any GPU.
  struct ftz32_cpu_admission {
    ftz32_cpu_failure failure = ftz32_cpu_failure::environment_unavailable;
    bool normal_rne = false, fused_fma = false, separate_rounding = false;
    bool signed_input_ftz = false, signed_output_ftz = false, core_exact = false;
    bool explicit_core_exact = false, controls_stable = false;
    ftz::native_fp_state before{}, after{};
    bool admitted() const noexcept { return failure == ftz32_cpu_failure::none; }
    bool explicit_compatible() const noexcept {
      return normal_rne && fused_fma && separate_rounding && explicit_core_exact && controls_stable;
    }
  };

}
export namespace ftz::detail {
  struct ftz32_cpu_witness { unsigned int operation, a, b, c, expected; };
  enum class ftz32_cpu_path { raw, compiled_core, explicit_core };
  using ftz32_cpu_evaluator = unsigned int (*)(ftz32_cpu_witness, ftz32_cpu_path);
  ftz32_cpu_admission ftz32_cpu_probe(ftz32_cpu_evaluator evaluate, bool hardware_ftz);
}
namespace ftz::detail {

  // Operations: 0 add, 1 multiply, 2 fused multiply-add, 3 separately rounded
  // multiply/add, 4 canonical word import. All literals are binary32 words.
  inline constexpr std::array ftz32_normal_witnesses {
    ftz32_cpu_witness{0,0x3f800000u,0x33800000u,0u,0x3f800000u},
    ftz32_cpu_witness{0,0xbf800000u,0xb3800000u,0u,0xbf800000u},
    ftz32_cpu_witness{0,0x3f800000u,0x34400000u,0u,0x3f800002u},
    ftz32_cpu_witness{0,0xbf800000u,0xb4400000u,0u,0xbf800002u},
    ftz32_cpu_witness{1,0x3f800001u,0x3f800001u,0u,0x3f800002u},
    ftz32_cpu_witness{1,0xbf800001u,0x3f800001u,0u,0xbf800002u}
  };
  inline constexpr std::array ftz32_fusion_witnesses {
    ftz32_cpu_witness{2,0x3f800001u,0x3f7ffffeu,0xbf800000u,0xa8800000u},
    ftz32_cpu_witness{2,0xbf800001u,0x3f7ffffeu,0x3f800000u,0x28800000u},
    ftz32_cpu_witness{3,0x3f800001u,0x3f7ffffeu,0xbf800000u,0u}
  };
  inline constexpr std::array ftz32_flush_witnesses {
    ftz32_cpu_witness{1,1u,0x7e800000u,0u,0u},
    ftz32_cpu_witness{1,0x80000001u,0x7e800000u,0u,0x80000000u},
    ftz32_cpu_witness{2,1u,0x7e800000u,0u,0u},
    ftz32_cpu_witness{2,0x80000001u,0x7e800000u,0x80000000u,0x80000000u},
    ftz32_cpu_witness{1,0x00800000u,0x3f000000u,0u,0u},
    ftz32_cpu_witness{1,0x80800000u,0x3f000000u,0u,0x80000000u},
    ftz32_cpu_witness{2,0x00800000u,0x3f000000u,0u,0u},
    ftz32_cpu_witness{2,0x80800000u,0x3f000000u,0x80000000u,0x80000000u},
    ftz32_cpu_witness{0,0x00800000u,0x80800001u,0u,0x80000000u},
    ftz32_cpu_witness{0,0x80800000u,0x00800001u,0u,0u}
  };
  inline constexpr std::array ftz32_core_witnesses {
    ftz32_cpu_witness{1,0x00800000u,0x3f7fffffu,0u,0x00800000u},
    ftz32_cpu_witness{1,0x80800000u,0x3f7fffffu,0u,0x80800000u},
    ftz32_cpu_witness{1,0x20000001u,0x1ffffffeu,0u,0x00800000u},
    ftz32_cpu_witness{1,0xa0000001u,0x1ffffffeu,0u,0x80800000u},
    ftz32_cpu_witness{2,0x00800000u,0x3f7fffffu,0u,0x00800000u},
    ftz32_cpu_witness{2,0x80800000u,0x3f7fffffu,0x80000000u,0x80800000u},
    ftz32_cpu_witness{2,0x20000001u,0x1ffffffeu,0u,0x00800000u},
    ftz32_cpu_witness{2,0xa0000001u,0x1ffffffeu,0x80000000u,0x80800000u},
    ftz32_cpu_witness{1,0x00800000u,0x3f7ffffeu,0u,0u},
    ftz32_cpu_witness{1,0x80800000u,0x3f7ffffeu,0u,0x80000000u},
    ftz32_cpu_witness{0,0x00800000u,0x80800001u,0u,0x80000000u},
    ftz32_cpu_witness{0,0x80800000u,0x00800001u,0u,0u},
    ftz32_cpu_witness{3,0x00800000u,0x3f800000u,0x80800001u,0x80000000u},
    ftz32_cpu_witness{3,0x80800000u,0x3f800000u,0x00800001u,0u},
    ftz32_cpu_witness{4,1u,0u,0u,0u},
    ftz32_cpu_witness{4,0x807fffffu,0u,0u,0x80000000u},
    ftz32_cpu_witness{4,0xff800001u,0u,0u,0x7fc00000u},
    ftz32_cpu_witness{4,0x00800000u,0u,0u,0x00800000u}
  };
  struct ftz32_cpu_observation {
    bool available = false, exception_masks = false, rounding_controls = false;
    ftz::native_fp_state before{}, after{};
    std::array<unsigned int, ftz32_normal_witnesses.size()> normal{};
    std::array<unsigned int, ftz32_fusion_witnesses.size()> fusion{};
    std::array<unsigned int, ftz32_flush_witnesses.size()> flush{};
    std::array<unsigned int, ftz32_core_witnesses.size()> core{}, explicit_core{};
  };

  template<std::size_t N> inline bool ftz32_cpu_matches(
      std::array<unsigned int,N> const & actual, std::array<ftz32_cpu_witness,N> const & rows,
      std::size_t first = 0, std::size_t end = N) noexcept {
    for (auto i = first; i < end; ++i) {
      unsigned int expected = rows[i].expected;
      // NaN sign and payload are outside the public value contract. Every
      // non-NaN bit, including the sign of zero, remains exact.
      if (actual[i] != expected && !((actual[i] & 0x7fffffffu) > 0x7f800000u && (expected & 0x7fffffffu) > 0x7f800000u)) return false;
    }
    return true;
  }
  ftz32_cpu_admission ftz32_cpu_classify(ftz32_cpu_observation const & o, bool hardware_ftz) noexcept {
    ftz32_cpu_admission r;
    r.before=o.before; r.after=o.after;
    if (!o.available) return r;
    r.controls_stable=o.before.control==o.after.control;
    r.normal_rne=o.exception_masks && o.rounding_controls && ftz32_cpu_matches(o.normal,ftz32_normal_witnesses);
    r.fused_fma=ftz32_cpu_matches(o.fusion,ftz32_fusion_witnesses,0,2);
    r.separate_rounding=ftz32_cpu_matches(o.fusion,ftz32_fusion_witnesses,2,3);
    r.signed_input_ftz=ftz32_cpu_matches(o.flush,ftz32_flush_witnesses,0,4);
    r.signed_output_ftz=ftz32_cpu_matches(o.flush,ftz32_flush_witnesses,4);
    r.core_exact=ftz32_cpu_matches(o.core,ftz32_core_witnesses);
    r.explicit_core_exact=ftz32_cpu_matches(o.explicit_core,ftz32_core_witnesses);
    bool hardware_missing = false;
    if (hardware_ftz)
      hardware_missing = !r.signed_input_ftz || !r.signed_output_ftz;
    if (!r.normal_rne || !r.fused_fma || !r.separate_rounding || !r.controls_stable)
      r.failure=ftz32_cpu_failure::normal_arithmetic;
    else if (hardware_missing)
      r.failure=ftz32_cpu_failure::hardware_ftz;
    else if (!r.core_exact) r.failure=ftz32_cpu_failure::core_contract;
    else r.failure=ftz32_cpu_failure::none;
    return r;
  }
  ftz32_cpu_observation ftz32_cpu_observe(ftz32_cpu_evaluator evaluate) {
    ftz32_cpu_observation o;
    o.available=ftz::native_fp32_environment_available();
    o.before=ftz::read_native_fp_state();
#if defined(_M_X64) || defined(__x86_64__)
    o.exception_masks=(o.before.control & 0x1f80u)==0x1f80u;
    o.rounding_controls=(o.before.control & 0x6000u)==0u;
#elif defined(__aarch64__) || defined(__arm64__)
    o.exception_masks=(o.before.control & ((0x1full<<8)|(1ull<<15)))==0u;
    o.rounding_controls=(o.before.control & ((3ull<<22)|7u))==0u;
#endif
    // Do not risk a hardware FP exception when the caller did not first
    // establish its numerical-thread scope. Wrong rounding is safe to test.
    if (o.available && o.exception_masks) {
      for (std::size_t i=0;i<o.normal.size();++i) o.normal[i]=evaluate(ftz32_normal_witnesses[i],ftz32_cpu_path::raw);
      for (std::size_t i=0;i<o.fusion.size();++i) o.fusion[i]=evaluate(ftz32_fusion_witnesses[i],ftz32_cpu_path::raw);
      for (std::size_t i=0;i<o.flush.size();++i) o.flush[i]=evaluate(ftz32_flush_witnesses[i],ftz32_cpu_path::raw);
      for (std::size_t i=0;i<o.core.size();++i) {
        o.core[i]=evaluate(ftz32_core_witnesses[i],ftz32_cpu_path::compiled_core);
        o.explicit_core[i]=evaluate(ftz32_core_witnesses[i],ftz32_cpu_path::explicit_core);
      }
    }
    o.after=ftz::read_native_fp_state();
    return o;
  }
  ftz32_cpu_admission ftz32_cpu_probe(ftz32_cpu_evaluator evaluate, bool hardware_ftz) {
    return ftz32_cpu_classify(ftz32_cpu_observe(evaluate), hardware_ftz);
  }
}
