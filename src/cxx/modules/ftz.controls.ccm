module;
#include <cstdint>
#include <array>
#include <thread>
#include <cassert>
#include <stdexcept>
#include <cstdio>
#include <exception>
#if defined(_M_X64) || defined(__x86_64__)
#include <xmmintrin.h>
#endif
export module ftz.controls;

export namespace ftz {
  // Native CPU environment only. These controls do not configure GPUs or Wasm.
  enum class native_fp32_mode { gradual, flush };
  struct native_fp_state {
    std::uint64_t control, status;
    friend bool operator==(native_fp_state const &, native_fp_state const &) = default;
  };
  bool native_fp32_environment_available() noexcept;
  native_fp_state read_native_fp_state() noexcept;

  // Application-owned numerical thread entry: set RNE, masked exceptions,
  // clear status flags and select denormal handling. No qualification, owner
  // lookup, allocation or restoration. Invalid/unavailable modes leave state
  // untouched and return false. ISA availability is a separate startup check.
  [[nodiscard]] bool set_native_fp32_mode(native_fp32_mode mode) noexcept;

  // Borrowed numerical region: save and restore the caller's complete state.
  // Construction establishes RNE, masked exceptions and clear status flags.
  // Native FTZ is not defined here as post-round software bit normalization.
  struct native_fp32_scope {
  private:
    native_fp_state previous_, requested_;
    std::thread::id owner_;
  public:
    explicit native_fp32_scope(native_fp32_mode mode);
    ~native_fp32_scope() noexcept;
    native_fp32_scope(native_fp32_scope const &) = delete;
    native_fp32_scope & operator=(native_fp32_scope const &) = delete;
    native_fp32_scope(native_fp32_scope &&) = delete;
    native_fp32_scope & operator=(native_fp32_scope &&) = delete;
    native_fp_state previous() const noexcept { return previous_; }
    native_fp_state requested() const noexcept { return requested_; }
    bool controls_match() const noexcept;

    // Restore the environment agreed with the caller while invoking external
    // code; restore this numerical region's current state on return/unwind.
    struct external_scope {
    private:
      native_fp_state previous_;
      std::thread::id owner_;
    public:
      explicit external_scope(native_fp32_scope const & region) noexcept;
      ~external_scope() noexcept;
      external_scope(external_scope const &) = delete;
      external_scope & operator=(external_scope const &) = delete;
      external_scope(external_scope &&) = delete;
      external_scope & operator=(external_scope &&) = delete;
    };
  };
}

namespace ftz {
  bool native_fp32_environment_available() noexcept {
#if defined(_M_X64) || defined(__x86_64__) || defined(__aarch64__) || defined(__arm64__)
    return true;
#else
    return false;
#endif
  }
  native_fp_state read_native_fp_state() noexcept {
#if defined(_M_X64) || defined(__x86_64__)
    auto word = _mm_getcsr();
    return {word & ~63u, word & 63u};
#elif defined(__aarch64__) || defined(__arm64__)
    native_fp_state state;
    __asm__ volatile("mrs %0, fpcr" : "=r"(state.control) : : "memory");
    __asm__ volatile("mrs %0, fpsr" : "=r"(state.status) : : "memory");
    return state;
#else
    return {};
#endif
  }
  namespace detail::fp32_environment {
    [[noreturn]] void failure(char const * reason, bool invalid = false) {
#if defined(__cpp_exceptions) || defined(_CPPUNWIND)
      if (invalid) throw std::invalid_argument(reason);
      throw std::runtime_error(reason);
#else
      (void)invalid;
      std::fputs(reason, stderr);
      std::fputc('\n', stderr);
      std::terminate();
#endif
    }
    void write_native_fp_state(native_fp_state state) noexcept {
#if defined(_M_X64) || defined(__x86_64__)
      _mm_setcsr(static_cast<unsigned int>(state.control | state.status));
#elif defined(__aarch64__) || defined(__arm64__)
      __asm__ volatile("msr fpcr, %0\n\tisb" : : "r"(state.control) : "memory");
      __asm__ volatile("msr fpsr, %0" : : "r"(state.status) : "memory");
#else
      (void)state;
#endif
    }
    native_fp_state requested_state(native_fp_state saved, native_fp32_mode mode) {
      if (!native_fp32_environment_available())
        failure("Native FP32 environment unavailable; use software arithmetic policy");
      if (mode != native_fp32_mode::gradual && mode != native_fp32_mode::flush)
        failure("Invalid native FP32 mode", true);
#if defined(_M_X64) || defined(__x86_64__)
      // The admitted x86 CPU environment supports MXCSR denormal controls.
      auto control = (saved.control & ~std::uint64_t(0xe040)) | 0x1f80u;
      if (mode == native_fp32_mode::flush) control |= 0x8040u;
      return {control, 0};
#elif defined(__aarch64__) || defined(__arm64__)
      // Standard ARM handling: AH/FIZ/NEP clear, RNE, FP traps disabled.
      // Preserve unrelated fields, including FP16 mode and default-NaN policy.
      constexpr std::uint64_t clear = 7u | (0x1full << 8) | (1ull << 15) |
        (3ull << 22) | (1ull << 24);
      auto control = saved.control & ~clear;
      if (mode == native_fp32_mode::flush) control |= 1ull << 24;
      return {control, 0};
#else
      return saved;
#endif
    }
  }
  bool set_native_fp32_mode(native_fp32_mode mode) noexcept {
    if (!native_fp32_environment_available() ||
        (mode != native_fp32_mode::gradual && mode != native_fp32_mode::flush)) return false;
    auto requested = detail::fp32_environment::requested_state(read_native_fp_state(), mode);
    detail::fp32_environment::write_native_fp_state(requested);
    return true;
  }
  native_fp32_scope::native_fp32_scope(native_fp32_mode mode)
    : previous_(read_native_fp_state()), requested_(detail::fp32_environment::requested_state(previous_, mode)),
      owner_(std::this_thread::get_id()) {
    detail::fp32_environment::write_native_fp_state(requested_);
    if (read_native_fp_state() != requested_) {
      detail::fp32_environment::write_native_fp_state(previous_);
      detail::fp32_environment::failure("Native FP32 environment did not accept requested controls");
    }
  }
  native_fp32_scope::~native_fp32_scope() noexcept {
    assert(owner_ == std::this_thread::get_id());
    detail::fp32_environment::write_native_fp_state(previous_);
  }
  bool native_fp32_scope::controls_match() const noexcept {
    return owner_ == std::this_thread::get_id() && read_native_fp_state().control == requested_.control;
  }
  native_fp32_scope::external_scope::external_scope(native_fp32_scope const & region) noexcept
    : previous_(read_native_fp_state()), owner_(std::this_thread::get_id()) {
    assert(region.owner_ == owner_);
    detail::fp32_environment::write_native_fp_state(region.previous_);
  }
  native_fp32_scope::external_scope::~external_scope() noexcept {
    assert(owner_ == std::this_thread::get_id());
    detail::fp32_environment::write_native_fp_state(previous_);
  }
}

