 * \endlicense
 * \author Edward Kmett <ekmett@gmail.com>
 * \brief Scalar float wrapper with signed FTZ, deterministic arithmetic, and math overloads.
 */

#include "ftz/simd.h"

namespace ftz::detail {
  using ::ftz::detail::ftz32_cpu_witness;
  using ::ftz::detail::ftz32_cpu_path;
  // Volatile input loads prevent compile-time evaluation. The noinline
  // boundary is a probe property, never part of ordinary value arithmetic.
  template <bool Hardware>
#if defined(_MSC_VER)
  __declspec(noinline)
#elif defined(__GNUC__) || defined(__clang__)
  __attribute__((noinline))
#endif
  inline unsigned int ftz32_cpu_evaluate(ftz32_cpu_witness row, ftz32_cpu_path path) {
    volatile unsigned int a_word = row.a, b_word = row.b, c_word = row.c;
    unsigned int a = a_word, b = b_word, c = c_word;
    if (path != ftz32_cpu_path::raw) {
      // Probe the explicit sibling's repaired addition independently of the
      // compiled profile. Other finite boundary witnesses use the shared
      // multiplication/FMA repair graph, which is unchanged by add policy.
      auto add = [path](unsigned int x, unsigned int y) {
        return path == ftz32_cpu_path::explicit_core ? ftz32_add_policy<false>(x,y) : ftz32_add<Hardware>(x,y);
      };
      switch (row.operation) {
        case 0: return add(a,b);
        case 1: return ftz32_mul(a,b);
        case 2: return ftz32_fma(a,b,c);
        case 3: return add(ftz32_mul(a,b),c);
        default: return ftz32_canonical(a);
      }
    }
    float x = std::bit_cast<float>(a), y = std::bit_cast<float>(b), z = std::bit_cast<float>(c);
    switch (row.operation) {
      case 0: return std::bit_cast<unsigned int>(x+y);
      case 1: return std::bit_cast<unsigned int>(x*y);
      case 2: return std::bit_cast<unsigned int>(std::fma(x,y,z));
      default: {
        float product = x*y;
        return std::bit_cast<unsigned int>(product+z);
      }
    }
  }
}

export namespace ftz {
  // Explicit compiled-profile qualification, normally once at process startup
  // under native_fp32_scope. Thread entry and arithmetic never call this bank.
  // Like arithmetic, the probe may set masked exception status flags; controls
  // stay untouched and the owning scope restores the caller's complete state.
  template <ftz32_type T = ftz32>
  [[nodiscard]] inline ftz32_cpu_admission probe_ftz32_cpu() {
    return ::ftz::detail::ftz32_cpu_probe(detail::ftz32_cpu_evaluate<T::hardware>, T::hardware);
  }
}

