@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(NOT ftz_FIND_COMPONENTS OR "ftz" IN_LIST ftz_FIND_COMPONENTS)
  find_dependency(simd CONFIG COMPONENTS simd headers)
  if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/ftzHostTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/ftzHostTargets.cmake")
    set(ftz_ftz_FOUND TRUE)
  else()
    set(ftz_ftz_FOUND FALSE)
    if(NOT ftz_FIND_COMPONENTS)
      set(ftz_FOUND FALSE)
      set(ftz_NOT_FOUND_MESSAGE "This ftz package contains shader headers only; request COMPONENTS hlsl.")
    endif()
  endif()
else()
  find_dependency(simd CONFIG COMPONENTS headers)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/ftzShaderTargets.cmake")
set(ftz_hlsl_FOUND TRUE)
check_required_components(ftz)
